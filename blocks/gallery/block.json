{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gaia/gallery",
  "title": "Galería",
  "description": "Rejilla de imágenes que se amplían al pulsarlas.",
  "category": "gaia",
  "icon": "format-gallery",
  "keywords": [
    "galería",
    "fotos",
    "imágenes"
  ],
  "textdomain": "gaia",
  "supports": {
    "anchor": true,
    "align": false,
    "html": false
  },
  "style": [
    "file:./gallery.css"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "gallery.php"
  },
  "viewScript": [
    "file:./gallery.js"
  ]
}
