{
  "name": "gaia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names sass,sync \"npm:watch:css\" \"npm:serve\"",
    "watch:css": "sass --watch --embed-sources assets/scss:assets/css blocks:blocks",
    "serve": "browser-sync start --config bs-config.cjs",
    "build": "sass --style=compressed --no-source-map assets/scss:assets/css blocks:blocks"
  },
  "devDependencies": {
    "browser-sync": "3.0.4",
    "concurrently": "10.0.6",
    "sass": "1.105.1"
  }
}
